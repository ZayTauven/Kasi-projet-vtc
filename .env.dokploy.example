# =============================================================================
# Kasi — variables d environnement pour un service Dokploy (type "Compose")
#
# Ce fichier n est PAS lu automatiquement. Son contenu se colle dans l UI
# Dokploy : service Kasi -> onglet "Environment". Dokploy ecrit alors un .env
# a cote du docker-compose.dokploy.yml au moment du deploiement.
#
# Une valeur par environnement : local, staging et production ont chacun leur
# propre jeu (bases distinctes, secrets distincts).
#
# Les variables marquees REQUIS font echouer le deploiement si elles manquent
# (syntaxe ${VAR:?...} dans docker-compose.dokploy.yml) — c est voulu : mieux
# vaut un deploiement rouge qu une base creee avec un mot de passe par defaut.
# =============================================================================

# -- Base de donnees PostgreSQL + PostGIS --------------------------------------
# REQUIS. Le conteneur postgres n est joignable que depuis kasi-net : ces
# identifiants ne sortent jamais de la stack. Ils restent a generer
# aleatoirement — la base contient les donnees clients et chauffeurs.
DB_NAME=kasi
DB_USER=kasi
DB_PASS=

# -- Redis ---------------------------------------------------------------------
# REQUIS. Sert aux subscriptions GraphQL (graphql-redis-subscriptions) et aux
# positions temps reel des Kasimen.
REDIS_PASSWORD=

# -- Authentification ----------------------------------------------------------
# REQUIS, 32 caracteres minimum.
# ATTENTION : changer ce secret invalide TOUS les jetons en circulation, donc
# deconnecte l integralite du parc mobile installe. A ne pas regenerer par
# reflexe lors de la bascule vers Dokploy — reprendre la valeur en place dans
# /opt/kasi/.env sur le VPS.
JWT_SECRET=

# -- Firebase Admin SDK --------------------------------------------------------
# Optionnel au demarrage de la stack, mais les notifications push et la
# verification des OTP ne fonctionnent pas sans.
# FIREBASE_PRIVATE_KEY contient des retours a la ligne : dans l UI Dokploy,
# les coller tels quels entre guillemets doubles.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -- Mapbox --------------------------------------------------------------------
# Token PUBLIC (pk.***) uniquement. Injecte dans le bundle Angular au BUILD :
# le modifier impose de relancer un deploiement complet, ce n est pas une
# variable runtime. Ne jamais mettre ici un token secret (sk.***), il
# finirait dans le JavaScript servi aux navigateurs.
# Le token des apps mobiles est distinct : il vit dans la table map_setting.
MAPBOX_TOKEN=
