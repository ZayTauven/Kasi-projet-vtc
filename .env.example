# =============================================================================
# Kasi — Template de variables d'environnement
# Copier ce fichier en .env et renseigner chaque valeur CHANGEME.
# Ce fichier est versionne (documentation) ; .env est ignore par git.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de donnees PostgreSQL + PostGIS
# En dev local sans Docker : DB_HOST=localhost
# Dans le reseau Docker Compose : DB_HOST=postgres (nom du service)
# -----------------------------------------------------------------------------
DB_NAME=kasi_database
DB_USER=postgres
DB_PASS=CHANGEME_kasi
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Grand livre (p2-argent I2, 2026-10-19)
# shadow (defaut) : une erreur du grand livre est journalisee et l'operation se
# fait quand meme ; strict : le grand livre fait foi, une ecriture refusee annule
# l'operation. Bascule en strict apres deux semaines de balayage a zero ecart.
# -----------------------------------------------------------------------------
LEDGER_MODE=shadow

# -----------------------------------------------------------------------------
# Dispatch (p2-dispatch D2-D3, 2026-10-20)
# legacy (defaut) : offre diffusee une fois, a la creation, a tout le rayon.
# waves : vagues 1, 2, 3 km puis rayon du service, 30 s d'intervalle, 5 Kasimen
# au plus par vague, « aucun Kasiman » 2 min apres la derniere vague.
# Reglages fins (driver-api, defauts ci-dessus) : DISPATCH_WAVE_RADII_M,
# DISPATCH_WAVE_INTERVAL_MS, DISPATCH_WAVE_SIZE, DISPATCH_EXPIRE_AFTER_MS,
# DISPATCH_BOOKING_LEAD_MS, DISPATCH_PREFER_SINGLE_SERVICE (Q9 : mono-service
# classes avant les polyvalents dans chaque anneau, vrai par defaut).
# Demande non servie (D6, Q12) : DISPATCH_UNSERVED_THRESHOLD (3),
# DISPATCH_UNSERVED_RADIUS_M (1000), DISPATCH_UNSERVED_WINDOW_MS (15 min),
# DISPATCH_UNSERVED_ALERT_RADIUS_M (5000), DISPATCH_UNSERVED_ALERT_COOLDOWN_MS (1 h).
# -----------------------------------------------------------------------------
DISPATCH_MODE=legacy

# -----------------------------------------------------------------------------
# p1-sentry (2026-10-20) : suivi des erreurs des API (docs/fiche-suivi-des-erreurs.md)
# Protocole Sentry : GlitchTip auto-heberge (cible) ou Sentry SaaS, seul le DSN
# change. Vide = aucun envoi (dev local, banc d'integration). Un DSN par API.
# Ne jamais committer de valeur ici ni journaliser un DSN.
# SENTRY_ENVIRONMENT : production, staging... (defaut : NODE_ENV)
# SENTRY_RELEASE : version deployee, par exemple le commit (facultatif)
# -----------------------------------------------------------------------------
SENTRY_DSN_ADMIN_API=
SENTRY_DSN_DRIVER_API=
SENTRY_DSN_RIDER_API=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# Redis
# En dev local sans Docker : REDIS_HOST=localhost
# Dans le reseau Docker Compose : REDIS_HOST=redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# JWT — OBLIGATOIRE. Secret unique d'au moins 32 caracteres (generer via :
# openssl rand -hex 32). Une seule valeur suffit pour les 3 APIs : chaque
# service en derive un secret PROPRE par audience (JWT_SECRET + '_rider' /
# '_driver' / '_admin'), de sorte qu'un jeton d'une app n'authentifie jamais
# contre une autre. NE PAS reutiliser la meme valeur entre environnements.
# Fail-closed : en production (NODE_ENV=production), les APIs REFUSENT de
# demarrer si JWT_SECRET est absent, vaut encore un placeholder CHANGEME_...,
# ou fait moins de 32 caracteres.
# -----------------------------------------------------------------------------
JWT_SECRET=781196fcb8359bf6588dd08af2285ac283e1a0aa9f9b85ddaa10daffdac4b6eb

# -----------------------------------------------------------------------------
# Firebase Admin SDK
# Laisser vide si Firebase n est pas active (a valider par kasi-integrations-auditor).
# Ne jamais committer les valeurs reelles — passer par un gestionnaire de secrets.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Fournisseur geographique
# GEO_PROVIDER=google   -> utilise Google Maps (necessite GOOGLE_MAPS_API_KEY)
# GEO_PROVIDER=nominatim -> utilise Nominatim/OSM (open-source, sans cle)
# -----------------------------------------------------------------------------
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# CORS — origines autorisees par les APIs NestJS
# En production, Nginx gere les headers CORS en amont ; cette variable
# restreint les origines acceptees directement par NestJS (defense en profondeur).
# Valeurs multiples separees par des virgules, sans espaces.
# Laisser vide pour utiliser les defauts de developpement local.
# -----------------------------------------------------------------------------
# CORS_ORIGIN=https://admin.kasigroupe.com

# -----------------------------------------------------------------------------
# Registre d'images Docker (utilise par docker-compose.yml pour `image:`)
# En dev local : laisser vide, `docker compose up --build` construit et tague
# les images localement (defaut kasi-local), aucun pull necessaire.
# Sur le serveur de production (/opt/kasi/.env) : renseigner IMAGE_REGISTRY avec
# la meme valeur que les tags pousses par deploy.yml, soit
# ghcr.io/<owner>/<repo> (ex: ghcr.io/ZayTauven/kasi) — necessaire pour que
# `docker compose pull` recupere les images buildees par CI/CD.
# -----------------------------------------------------------------------------
IMAGE_REGISTRY=
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Mapbox GL JS — token public (pk.xxx) utilise par l'admin-panel pour l'affichage
# des cartes (voir KASI_DECISIONS.md, 2026-07-01 "migration Google Maps -> Mapbox").
# Injecte au build Docker via l'ARG MAPBOX_TOKEN (docker-compose.yml, apps/admin-panel/Dockerfile)
# dans src/environments/environment.prod.ts — jamais committe en dur dans le code source.
# Sans valeur : le build reussit quand meme, seules les cartes restent vides.
# -----------------------------------------------------------------------------
MAPBOX_TOKEN=
